{% extends "base.html" %}
{% block title %}Browse Courses{% endblock %}
{% block content %}
<h2>Available Courses</h2>
<div class="row">
    {% for course in courses %}
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>{{ course.title }}</h5>
                <p>{{ course.description[:100] }}</p>
                <p class="text-muted">Teacher: {{ course.teacher_name }}</p>
                <a href="{{ url_for('enroll_course_route', course_id=course.id) }}" class="btn btn-success">Enroll Now</a>
            </div>
        </div>
    </div>
    {% else %}
    <p>No courses available to enroll.</p>
    {% endfor %}
</div>
{% endblock %}